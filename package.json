{
  "name": "verilog-fixer-v1",
  "displayName": "Verilog BeginEnd Fixer",
  "publisher": "local",
  "description": "Auto add begin/end for always/if/else/for in Verilog",
  "version": "1.3.0",
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node out/begin_end.test.js && node out/vivado_validator.test.js"
  },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onCommand:verilog-helper.fixBeginEnd"],
  "main": "./out/main.js",
  "contributes": {
    "commands": [
      { "command": "verilog-helper.fixBeginEnd", "title": "Verilog: Auto add begin-end" }
    ],
    "keybindings": [
      {
        "command": "verilog-helper.fixBeginEnd",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && (editorLangId == verilog || editorLangId == systemverilog)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "verilog-helper.fixBeginEnd",
          "when": "editorLangId == verilog || editorLangId == systemverilog",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Verilog BeginEnd Fixer",
      "properties": {
        "verilog-helper.vivadoPath": {
          "type": "string",
          "default": "",
          "description": "Vivado 安装目录（例如 C:\\Xilinx\\Vivado\\2023.2），也可直接填写 xvlog.bat 的完整路径。"
        },
        "verilog-helper.vivadoTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "Vivado xvlog 校验超时时间，单位为毫秒。"
        }
      }
    }
  }
}
