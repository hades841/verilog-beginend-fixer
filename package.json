{
  "name": "verilog-fixer-v1",
  "displayName": "Verilog BeginEnd Fixer",
  "publisher": "local",
  "description": "Auto add begin/end for always/if/else/for in Verilog",
  "version": "1.3.0",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "activationEvents": ["onCommand:verilog-helper.fixBeginEnd"],
  "main": "./out/main.js",
  "contributes": {
    "commands": [
      { "command": "verilog-helper.fixBeginEnd", "title": "Verilog: Auto add begin-end" }
    ],
    "keybindings": [
      {
        "command": "verilog-helper.fixBeginEnd",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && (editorLangId == verilog || editorLangId == systemverilog)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "verilog-helper.fixBeginEnd",
          "when": "editorLangId == verilog || editorLangId == systemverilog",
          "group": "navigation"
        }
      ]
    }
  }
}