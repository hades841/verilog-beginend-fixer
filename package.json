{
  "name": "verilog-fixer-v1",
  "displayName": "Verilog BeginEnd Fixer",
  "publisher": "hades841",
  "description": "为 Verilog/SystemVerilog 自动补充 begin/end，并在写入前通过 Vivado xvlog 校验。",
  "version": "1.3.2",
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node out/begin_end.test.js && node out/vivado_validator.test.js"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.3"
  },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "keywords": ["verilog", "systemverilog", "fpga", "vivado", "begin", "end"],
  "activationEvents": ["onCommand:verilog-helper.fixBeginEnd"],
  "main": "./out/main.js",
  "icon": "resources/verilog-beginend-fixer-512.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hades841/verilog-beginend-fixer.git"
  },
  "homepage": "https://github.com/hades841/verilog-beginend-fixer#readme",
  "bugs": {
    "url": "https://github.com/hades841/verilog-beginend-fixer/issues",
    "email": "1842384443@qq.com"
  },
  "contributes": {
    "commands": [
      { "command": "verilog-helper.fixBeginEnd", "title": "Verilog: Auto add begin-end" }
    ],
    "keybindings": [
      {
        "command": "verilog-helper.fixBeginEnd",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && (editorLangId == verilog || editorLangId == systemverilog)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "verilog-helper.fixBeginEnd",
          "when": "editorLangId == verilog || editorLangId == systemverilog",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Verilog BeginEnd Fixer",
      "properties": {
        "verilog-helper.vivadoPath": {
          "type": "string",
          "default": "",
          "description": "Vivado 安装目录（例如 C:\\Xilinx\\Vivado\\2023.2），也可直接填写 xvlog.bat 的完整路径。"
        },
        "verilog-helper.vivadoTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "Vivado xvlog 校验超时时间，单位为毫秒。"
        },
        "verilog-helper.vivadoIncludePaths": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "额外的 Vivado xvlog include 搜索目录。源文件所在目录会自动加入。"
        }
      }
    }
  }
}
